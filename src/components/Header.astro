---
import HeaderLink from "./HeaderLink.astro";
import Dock from "@/components/ui/dock";
import { FaSun, FaMoon } from "react-icons/fa";

const isBlogRoute = Astro.url.pathname.startsWith("/blog");
---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur">
    <nav
        class="relative mx-auto flex w-full max-w-6xl items-center justify-center px-4 py-4"
    >
        <div class="flex items-center gap-6 text-xs sm:text-sm font-medium">
            <HeaderLink href="/" class="hover:text-primary"> Home </HeaderLink>
            <HeaderLink href="/blog" class="hover:text-primary">
                Blogs
            </HeaderLink>
            <button
                type="button"
                class="theme-toggle inline-flex h-7 w-7 items-center justify-center text-muted-foreground hover:text-foreground"
            >
                <span class="sr-only" data-theme-label>Dark</span>
                <FaSun className="h-4 w-4 dark:hidden" />
                <FaMoon className="hidden h-4 w-4 dark:block" />
            </button>
        </div>
    </nav>
</header>

<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
    {!isBlogRoute && <Dock client:load />}
</div>
