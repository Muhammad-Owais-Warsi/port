---
import HeaderLink from "./HeaderLink.astro";
import Dock from "@/components/ui/dock";
import { ModeToggle } from "@/components/ui/theme-toggle"; // Adjust path if file name is different

const isBlogRoute = Astro.url.pathname.startsWith("/blog");
---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur">
    <nav
        class="relative mx-auto flex w-full max-w-6xl items-center justify-center px-4 py-4"
    >
        <div class="flex items-center gap-8 text-sm font-medium">
            <HeaderLink href="/" class="hover:text-primary transition-colors">
                Home
            </HeaderLink>
            <HeaderLink
                href="/blog"
                class="hover:text-primary transition-colors"
            >
                Blogs
            </HeaderLink>
        </div>

        <div class="absolute right-4 flex items-center">
            <!-- <ModeToggle client:load /> -->
        </div>
    </nav>
</header>

<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
    {!isBlogRoute && <Dock client:load />}
</div>
