---
import type { MarkdownHeading } from "astro";

interface TocEntry {
    slug: string;
    text: string;
    title: string;
    depth: number;
}

interface Props {
    headings: MarkdownHeading[];
    toc?: Array<string | { text: string; title?: string }>;
}

const { headings, toc = [] } = Astro.props;

// Normalize punctuation differences (e.g. straight vs. typographic apostrophes)
// that remark can introduce when rendering heading text, so curated TOC entries
// still match even if the source uses a different character.
const normalize = (s: string) =>
    s
        .trim()
        .toLowerCase()
        .replace(/[\u2019\u2018]/g, "'");

// Bind each curated TOC entry (in order) to the next matching heading. This lets
// repeated headings (e.g. several "Final State" sections) each get its own title.
const used = new Set<number>();
const entries: TocEntry[] = [];
toc.forEach((entry) => {
    const text = typeof entry === "string" ? entry : entry.text;
    const title = typeof entry === "string" ? text : entry.title ?? text;
    const key = normalize(text);
    const idx = headings.findIndex(
        (h, i) => !used.has(i) && normalize(h.text) === key
    );
    if (idx === -1) return;
    used.add(idx);
    const h = headings[idx];
    entries.push({
        slug: h.slug,
        text: h.text,
        title,
        depth: h.depth,
    });
});
---

{
    entries.length > 0 && (
        <div data-toc-root>
            {/* Desktop: Medium-style minimap docked to the article side */}
            <div class="group hidden lg:block fixed right-4 top-1/2 -translate-y-1/2 z-40 before:absolute before:right-full before:top-0 before:h-full before:w-3 before:content-['']">
                <div
                    data-toc-ticks
                    class="flex flex-col items-center gap-2.5 px-3 py-3"
                >
                    {entries.map((entry, i) => (
                        <a
                            href={`#${entry.slug}`}
                            data-sidebar-heading
                            data-toc-tick={entry.slug}
                            aria-label={entry.title}
                            class="flex w-8 justify-center py-0.5"
                        >
                            <span
                                data-toc-bar
                                data-active={i === 0 ? "true" : "false"}
                                class:list={[
                                    "block h-[3px] w-6 rounded-full",
                                    i === 0
                                        ? "bg-foreground"
                                        : "bg-muted-foreground/30",
                                ]}
                            />
                        </a>
                    ))}
                </div>
                <div class="pointer-events-none absolute right-full top-1/2 mr-2 w-56 -translate-y-1/2 translate-x-1 rounded-xl border border-border bg-card p-4 opacity-0 shadow-lg transition group-hover:pointer-events-auto group-hover:translate-x-0 group-hover:opacity-100">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        On this page
                    </p>
                    <ul class="toc-scroll max-h-72 space-y-2 overflow-y-auto pr-1">
                        {entries.map((entry) => (
                            <li>
                                <a
                                    href={`#${entry.slug}`}
                                    data-sidebar-heading
                                    data-toc-link={entry.slug}
                                    class="block break-words text-sm font-medium text-muted-foreground hover:text-primary"
                                >
                                    {entry.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            {/* Mobile: floating handle + bottom sheet */}
            <div class="lg:hidden pointer-events-auto">
                <button
                    type="button"
                    data-toc-mobile-open
                    aria-label="Open table of contents"
                    class="fixed bottom-5 left-5 inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-xs font-medium text-foreground shadow-md cursor-pointer"
                >
                    <span class="flex flex-col gap-0.5">
                        <span class="h-0.5 w-3 rounded-full bg-muted-foreground"></span>
                        <span class="h-0.5 w-3 rounded-full bg-muted-foreground"></span>
                    </span>
                    Contents
                </button>
                <div
                    data-toc-sheet-backdrop
                    class="fixed inset-0 hidden bg-black/40"
                ></div>
                <div
                    data-toc-sheet
                    class="fixed inset-x-0 bottom-0 hidden max-h-[70vh] rounded-t-2xl border-t border-border bg-card p-5 pb-8 shadow-lg"
                >
                    <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-border"></div>
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                        On this page
                    </p>
                    <ul class="toc-scroll max-h-[50vh] space-y-3 overflow-y-auto pr-1">
                        {entries.map((entry) => (
                            <li>
                                <a
                                    href={`#${entry.slug}`}
                                    data-sidebar-heading
                                    class="block break-words text-[0.9375rem] font-medium text-foreground"
                                >
                                    {entry.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    )
}

<script>
    const mobileOpen = document.querySelector("[data-toc-mobile-open]");
    const backdrop = document.querySelector("[data-toc-sheet-backdrop]");
    const sheet = document.querySelector("[data-toc-sheet]");

    const baseOffset = 80;

    const scrollToHeading = (slug) => {
        const el = document.getElementById(slug);
        if (!el) return;
        const top = el.getBoundingClientRect().top + window.scrollY - baseOffset;
        window.scrollTo({ top, behavior: "smooth" });
    };

    const closeSheet = () => {
        sheet?.classList.add("hidden");
        backdrop?.classList.add("hidden");
    };

    mobileOpen?.addEventListener("click", () => {
        backdrop?.classList.remove("hidden");
        sheet?.classList.remove("hidden");
    });

    backdrop?.addEventListener("click", closeSheet);

    document.querySelectorAll("[data-sidebar-heading]").forEach((link) => {
        link.addEventListener("click", (e) => {
            e.preventDefault();
            const id = link.getAttribute("href")?.slice(1);
            if (id) scrollToHeading(id);
            closeSheet();
        });
    });

    document.addEventListener("click", (e) => {
        const controller = e.target.closest?.("[data-toc-root]");
        const sheetOpen = sheet && !sheet.classList.contains("hidden");
        if (sheetOpen && !controller) {
            closeSheet();
        }
    });

    // Scrollspy: highlight the tick + panel link of the section in view.
    const bars = new Map();
    const links = new Map();
    document.querySelectorAll("[data-toc-bar]").forEach((bar) => {
        const tick = bar.closest("[data-toc-tick]");
        const slug = tick?.getAttribute("data-toc-tick");
        if (slug) bars.set(slug, bar);
    });
    document.querySelectorAll("[data-toc-link]").forEach((link) => {
        const slug = link.getAttribute("data-toc-link");
        if (slug) links.set(slug, link);
    });

    const setActive = (slug) => {
        bars.forEach((bar, key) => {
            const on = key === slug;
            bar.classList.toggle("bg-foreground", on);
            bar.classList.toggle("bg-muted-foreground/30", !on);
            bar.setAttribute("data-active", String(on));
        });
        links.forEach((link, key) => {
            const on = key === slug;
            link.classList.toggle("text-primary", on);
            link.classList.toggle("text-muted-foreground", !on);
        });
    };

    const sections = [];
    bars.forEach((_, slug) => {
        const el = document.getElementById(slug);
        if (el) sections.push({ slug, el });
    });

    const spyOffset = baseOffset + 40;
    let ticking = false;
    const updateSpy = () => {
        ticking = false;
        const y = window.scrollY + spyOffset;
        let current = sections.length > 0 ? sections[0].slug : null;
        for (const s of sections) {
            if (s.el.getBoundingClientRect().top + window.scrollY <= y) {
                current = s.slug;
            } else {
                break;
            }
        }
        // At page bottom there may not be enough content left for the last
        // heading to cross the trigger line — activate it explicitly.
        const atBottom =
            window.innerHeight + window.scrollY >=
            document.documentElement.scrollHeight - 4;
        if (atBottom && sections.length > 0) {
            current = sections[sections.length - 1].slug;
        }
        if (current) setActive(current);
    };

    if (sections.length > 0) {
        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    ticking = true;
                    requestAnimationFrame(updateSpy);
                }
            },
            { passive: true }
        );
        updateSpy();
    }
</script>

<style>
    .toc-scroll {
        scrollbar-width: thin;
        scrollbar-color: var(--muted-foreground) transparent;
    }

    .toc-scroll::-webkit-scrollbar {
        width: 5px;
    }

    .toc-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .toc-scroll::-webkit-scrollbar-thumb {
        background-color: var(--muted-foreground);
        border-radius: 9999px;
        opacity: 0.5;
    }

    .toc-scroll::-webkit-scrollbar-thumb:hover {
        background-color: var(--border);
    }
</style>
