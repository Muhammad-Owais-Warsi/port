---
interface Benchmark {
    name: string;
    created: string;
    paper?: string;
    claim: string;
    tests: string;
    critiques: string;
    score: string;
}

interface Props {
    benchmarks: Benchmark[];
}

const { benchmarks } = Astro.props;

function parseLinks(text: string): string {
    return text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, url) => {
        return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4">${label}</a>`;
    });
}
---

<div class="benchmark-carousel not-prose my-6">
    <div class="relative border border-border rounded-lg bg-card overflow-hidden">
        <!-- Cards -->
        <div class="cards-container relative">
            {benchmarks.map((b, i) => (
                <div class:list={["card p-5 sm:p-6", { hidden: i !== 0 }]} data-index={i}>
                    <div class="mb-4">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="text-base font-semibold text-foreground">{b.name}</h3>
                            {b.paper && (
                                <a
                                    href={b.paper}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-xs text-primary underline underline-offset-4 shrink-0 mt-0.5"
                                >
                                    paper
                                </a>
                            )}
                        </div>
                        <p class="text-xs text-muted-foreground mt-0.5">{b.created}</p>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-muted-foreground font-medium mb-1">What they claim</p>
                            <p class="text-sm text-foreground/80">{b.claim}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-muted-foreground font-medium mb-1">What it tests</p>
                            <p class="text-sm text-foreground/80">{b.tests}</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-muted-foreground font-medium mb-1">Critiques</p>
                            <p class="text-sm text-foreground/80" set:html={parseLinks(b.critiques)} />
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-muted-foreground font-medium mb-1">What the score means</p>
                            <p class="text-sm text-foreground/80">{b.score}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <!-- Navigation -->
        <div class="flex items-center justify-between px-4 py-3 border-t border-border">
            <button
                class="prev-btn flex items-center justify-center w-8 h-8 rounded-md hover:bg-muted disabled:opacity-30 disabled:cursor-not-allowed text-foreground"
                aria-label="Previous"
                disabled
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
            </button>
            <span class="counter text-sm text-muted-foreground tabular-nums">1 / {benchmarks.length}</span>
            <button
                class="next-btn flex items-center justify-center w-8 h-8 rounded-md hover:bg-muted disabled:opacity-30 disabled:cursor-not-allowed text-foreground"
                aria-label="Next"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m9 18 6-6-6-6"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Dots -->
    <div class="dots flex items-center justify-center gap-1.5 mt-3 flex-wrap">
        {benchmarks.map((_, i) => (
            <button
                class:list={["dot w-1.5 h-1.5 rounded-full", i === 0 ? "bg-primary" : "bg-border"]}
                data-index={i}
                aria-label={`Go to benchmark ${i + 1}`}
            />
        ))}
    </div>
</div>

<script>
    document.querySelectorAll(".benchmark-carousel").forEach((wrapper) => {
        const cards = wrapper.querySelectorAll<HTMLElement>(".card");
        const dots = wrapper.querySelectorAll<HTMLButtonElement>(".dot");
        const prevBtn = wrapper.querySelector<HTMLButtonElement>(".prev-btn")!;
        const nextBtn = wrapper.querySelector<HTMLButtonElement>(".next-btn")!;
        const counter = wrapper.querySelector<HTMLElement>(".counter")!;
        const cardsContainer = wrapper.querySelector<HTMLElement>(".cards-container")!;
        const total = cards.length;
        let current = 0;

        function lockHeight() {
            // Show all cards in flow to measure their real height at current width
            cards.forEach((card) => card.classList.remove("hidden"));
            cardsContainer.style.minHeight = "";
            let maxHeight = 0;
            cards.forEach((card) => {
                maxHeight = Math.max(maxHeight, card.getBoundingClientRect().height);
            });
            cardsContainer.style.minHeight = maxHeight + "px";
            // Hide all except current
            cards.forEach((card, i) => {
                if (i !== current) card.classList.add("hidden");
            });
        }

        lockHeight();
        window.addEventListener("resize", lockHeight);

        function goTo(index: number) {
            cards[current].classList.add("hidden");
            dots[current].classList.remove("bg-primary");
            dots[current].classList.add("bg-border");

            current = index;

            cards[current].classList.remove("hidden");
            // scroll card into view if needed
            cardsContainer.scrollTop = 0;
            dots[current].classList.remove("bg-border");
            dots[current].classList.add("bg-primary");

            counter.textContent = `${current + 1} / ${total}`;
            prevBtn.disabled = current === 0;
            nextBtn.disabled = current === total - 1;
        }

        prevBtn.addEventListener("click", () => { if (current > 0) goTo(current - 1); });
        nextBtn.addEventListener("click", () => { if (current < total - 1) goTo(current + 1); });
        dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

        // Swipe support
        let touchStartX = 0;
        let touchStartY = 0;

        cardsContainer.addEventListener("touchstart", (e) => {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        }, { passive: true });

        cardsContainer.addEventListener("touchend", (e) => {
            const dx = e.changedTouches[0].clientX - touchStartX;
            const dy = e.changedTouches[0].clientY - touchStartY;
            // Only treat as horizontal swipe if horizontal movement dominates
            if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
            if (dx < 0 && current < total - 1) goTo(current + 1);
            if (dx > 0 && current > 0) goTo(current - 1);
        }, { passive: true });

        // init state
        nextBtn.disabled = total <= 1;
    });
</script>
