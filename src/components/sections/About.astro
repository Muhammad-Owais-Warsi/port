---
interface Props {
    heading?: string;
}

const { heading = "About Me" } = Astro.props;
---

<section id="about" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-10">
    <div class="mx-auto max-w-3xl">
        <h2
            class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground mb-4 sm:mb-6"
        >
            {heading}
        </h2>

        <ul
            class="space-y-3 text-sm sm:text-base leading-relaxed text-foreground/80"
        >
            <li class="flex gap-3">
                <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-muted-foreground"
                ></span>
                <span>
                    An undergrad who used to hate computer science, but now
                    spend hours running agents and debugging.
                </span>
            </li>
            <li class="flex gap-3">
                <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-muted-foreground"
                ></span>
                <span>
                    Benchmarking frontier models and building evals
                    <a
                        href="https://ressl.ai/"
                        class="underline underline-offset-4 decoration-current text-primary"
                    >
                        @ResslAI
                    </a>
                </span>
            </li>
            <li class="flex gap-3">
                <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-muted-foreground"
                ></span>
                <span>
                    Building products across full stack applications, SDKs and
                    developer tools.
                </span>
            </li>
            <li class="flex gap-3">
                <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-muted-foreground"
                ></span>
                <span>
                    Writing
                    <a
                        href="/blog"
                        class="underline underline-offset-4 decoration-current text-primary"
                    >
                        blogs
                    </a>
                    on AI, systems and devtools.
                </span>
            </li>
        </ul>
    </div>
</section>
