---
interface Props {
    heading?: string;
}

const { heading = "About Me" } = Astro.props;
---

<section id="about" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-10">
    <div class="mx-auto max-w-3xl">
        <h2
            class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground mb-4 sm:mb-6"
        >
            {heading}
        </h2>

        <div
            class="space-y-4 sm:space-y-5 text-sm sm:text-base leading-relaxed text-foreground/80 text-pretty"
        >
            <p>
                I'm currently an undergrad pursuing my Bachelors degree. From
                hating C.S. every second to spending hours debugging a bug.
            </p>

            <p>
                Building products across full stack applications, SDKs and
                developer tools. I also sometimes write
                <a
                    href="/blog"
                    class="underline underline-offset-4 decoration-border/80 text-primary"
                >
                    blogs
                </a>
                , exploring new technologies, and collaborating with others.
            </p>

            <p>
                That's all, nothing too special. Probably building or writing
                while you're reading this.
            </p>

            <p>Thanks for reading :)</p>
        </div>
    </div>
</section>
