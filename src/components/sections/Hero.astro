---
import { Image } from "astro:assets";
import myImage from "../../assets/me2.webp";

interface Props {
    heading?: string;
    description?: string;
    comment: string;
    command: string;
}

const {
    heading = "Hey, I'm Muhammad Owais Warsi",
    description = "A passionate developer who loves to ship products.",
    comment = "Type this in your terminal for quick intro.",
    command = "npx mowarsi",
} = Astro.props;
---

<section class="py-16 sm:py-20">
    <div class="mx-auto w-full max-w-4xl px-4 text-center">
        <div class="mb-8 flex justify-center">
            <Image
                src={myImage}
                alt="Muhammad Owais Warsi"
                width={160}
                height={160}
                loading="eager"
                class="rounded-full object-cover"
            />
        </div>

        <h1
            class="mt-4 text-balance text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight"
        >
            {heading}
        </h1>
        <p class="mt-4 text-lg text-muted-foreground">{description}</p>

        <div class="mt-10 flex justify-center">
            <div
                class="w-full max-w-md rounded-lg border border-border px-6 py-8"
            >
                <div class="flex flex-col gap-2 font-mono text-sm sm:text-base">
                    <span class="text-muted-foreground italic">
                        // {comment}
                    </span>
                    <span class="text-foreground font-semibold">
                        {command}
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>
