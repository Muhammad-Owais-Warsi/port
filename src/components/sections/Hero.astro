---
interface Props {
    heading?: string;
    description?: string;
}

const {
    heading = "Muhammad Owais Warsi",
    description = "<span >Full Stack</span> developer.",
} = Astro.props;
---

<section id="hero" class="pt-10 sm:pt-12 pb-6 sm:pb-8 px-4 sm:px-6 lg:px-10">
    <div class="mx-auto w-full max-w-3xl text-left">
        <h1 class="text-balance text-3xl sm:text-4xl font-bold tracking-tight">
            {heading}
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-muted-foreground">
            <Fragment set:html={description} />
        </p>
    </div>
</section>
