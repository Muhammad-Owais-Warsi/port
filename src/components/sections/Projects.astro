---
import { FiArrowUpRight } from "react-icons/fi";
import { PROJECTS } from "../../data/projects";

const getStatusColor = (pos?: string) => {
    if (pos === "#1") return "bg-yellow-500";
    if (pos === "#2") return "bg-zinc-400";
    if (pos === "#3") return "bg-amber-600";
    return "bg-emerald-500";
};
---

<section id="projects" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-10">
    <div class="mx-auto max-w-3xl">
        <h2
            class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground mb-4 sm:mb-6"
        >
            Projects
        </h2>

        <div class="space-y-8 sm:space-y-10">
            {
                PROJECTS.map((project) => (
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2">
                            <a
                                href={project.url}
                                target="_blank"
                                class="group inline-flex items-center gap-2 text-sm sm:text-base font-semibold text-foreground hover:text-primary"
                            >
                                <span>{project.name}</span>
                                <FiArrowUpRight className="h-4 w-4 text-muted-foreground group-hover:text-primary" />
                            </a>
                        </div>

                        <p class="text-foreground/70 text-sm sm:text-base leading-snug">
                            {project.description}
                        </p>

                        <div class="flex flex-wrap items-center gap-2 text-[11px] text-muted-foreground">
                            <span class="font-semibold text-foreground/80">
                                Tech Stack:
                            </span>
                            {project.stack.map((tech) => (
                                <span class="rounded-full border border-border px-2 py-0.5 text-[11px] font-medium text-foreground/80">
                                    {tech}
                                </span>
                            ))}
                        </div>

                        {project.launched_position && (
                            <div class="flex items-center gap-2 mt-1">
                                <span
                                    class={`inline-flex h-2 w-2 rounded-full ${getStatusColor(project.launched_position)}`}
                                />
                                <a
                                    href={project.launched_url}
                                    target="_blank"
                                    class="text-xs font-semibold text-muted-foreground hover:text-primary"
                                >
                                    Launched on Peerlist{" "}
                                    {project.launched_position}
                                </a>
                            </div>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</section>
