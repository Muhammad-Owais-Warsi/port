---
interface ExperienceItem {
    title: string;
    company: string;
    location?: string;
    start: string;
    end?: string;
}

interface Props {
    heading?: string;
    experiences?: ExperienceItem[];
}

const {
    heading = "Work Experience",
    experiences = [
        {
            title: "Founding Engineering Intern",
            company: "Cueron",
            location: "Remote",
            start: "Dec 2025",
            end: "Present",
        },
    ],
} = Astro.props;
---

<section id="experience" class="py-10 sm:py-16 px-4 sm:px-6">
    <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-6 sm:mb-10">
            {heading}
        </h2>

        <div class="space-y-8 sm:space-y-12">
            {
                experiences.map((item) => (
                    <div class="relative group">
                        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 sm:gap-2 mb-3 sm:mb-4">
                            <div class="space-y-1">
                                <h3 class="text-lg sm:text-xl font-bold text-foreground">
                                    {item.title}
                                </h3>
                                <div class="text-muted-foreground font-medium text-sm sm:text-base">
                                    <span>{item.company}</span>
                                    {item.location && (
                                        <span class="text-muted-foreground/60">
                                            {" "}
                                            · {item.location}
                                        </span>
                                    )}
                                </div>
                            </div>

                            <div class="text-sm sm:text-base font-semibold text-foreground  whitespace-nowrap">
                                {item.start} — {item.end ?? "Present"}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
