---
import { EXPERIENCES } from "../../data/experience";

interface Props {
    heading?: string;
}

const {
    heading = "Work Experience",
} = Astro.props;

const experiences = EXPERIENCES;
---

<section id="experience" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-10">
    <div class="mx-auto max-w-3xl">
        <h2
            class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground mb-4 sm:mb-6"
        >
            {heading}
        </h2>

        <div class="space-y-8 sm:space-y-12">
            {
                experiences.map((item) => (
                    <div class="relative group">
                        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 sm:gap-2 mb-3 sm:mb-4">
                            <div class="space-y-1">
                                <h3 class="text-sm sm:text-base font-semibold text-foreground">
                                    {item.title}
                                </h3>
                                <div class="text-foreground/70 font-semibold text-xs sm:text-sm">
                                    <span>{item.company}</span>
                                    {item.location && (
                                        <span class="text-foreground/60">
                                            {" "}
                                            · {item.location}
                                        </span>
                                    )}
                                </div>
                            </div>

                            <div class="text-xs sm:text-sm font-semibold text-foreground/70 whitespace-nowrap">
                                {item.start} — {item.end ?? "Present"}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
