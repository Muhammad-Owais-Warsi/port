---
interface Props {
    command?: string;
    comment?: string;
}

const {
    command = "npx mowarsi",
    comment = "// Type this in your terminal for a quick intro.",
} = Astro.props;
---

<section aria-label="Terminal command" class="px-4 sm:px-6 lg:px-10">
    <div class="mx-auto w-full max-w-3xl">
        <div
            id="command-callout"
            role="button"
            tabindex="0"
            class="w-full max-w-xl cursor-pointer select-none rounded-md border border-border bg-card/70 px-4 py-2 text-xs sm:text-sm font-mono"
        >
            <div class="text-muted-foreground">{comment}</div>
            <div id="command-text" class="mt-1 text-foreground">
                {command}
            </div>
        </div>
    </div>
</section>

<script>
    const callout = document.getElementById("command-callout");
    const commandText = document.getElementById("command-text");

    const copyCommand = async () => {
        if (!commandText) return;
        const text = commandText.textContent?.trim() ?? "";
        if (!text) return;

        await navigator.clipboard.writeText(text);
        commandText.classList.add("select-bg");
        setTimeout(() => {
            commandText.classList.remove("select-bg");
        }, 1200);
    };

    if (callout) {
        callout.addEventListener("click", copyCommand);
        callout.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                copyCommand();
            }
        });
    }
</script>
