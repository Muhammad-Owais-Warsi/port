---
import { FiArrowUpRight } from "react-icons/fi";

interface Contribution {
    name: string;
    url: string;
    description: string;
}

const CONTRIBUTIONS: Contribution[] = [
  {
    name: "Zed",
    url: "https://github.com/zed-industries/zed/pull/52740",
    description: "Zed is a high-performance, multiplayer code editor from the creators of Atom and Tree-sitter."
  },
    {
        name: "0.mail",
        url: "https://github.com/Mail-0/Zero/pull/591",
        description: "Open source alternative to Gmail.",
    },
    {
        name: "Nimbus",
        url: "https://github.com/nimbusdotstorage/Nimbus/pulls?q=is%3Apr+author%3AMuhammad-Owais-Warsi",
        description: "Open source alternative to Google Drive.",
    },
    {
        name: "Hacktoberfest",
        url: "https://github.com/Hacktoberfest/hacktoberfest-2022/pull/87",
        description: "Contributed to the Hacktoberfest official site.",
    },
    {
        name: "Call",
        url: "https://github.com/call0dotco/Call/pulls?q=is%3Apr+author%3AMuhammad-Owais-Warsi",
        description: "Open source alternative to Google Meet and Zoom.",
    },
    {
        name: "Val Town",
        url: "https://github.com/val-town/val-town-docs/pull/245",
        description: "Collaborative website to write and run code.",
    },
    {
        name: "Arcjet",
        url: "https://github.com/arcjet/arcjet-docs/pulls?q=is%3Apr+author%3AMuhammad-Owais-Warsi+",
        description: "A security SDK for developers.",
    },
    {
        name: "Git Cliff",
        url: "https://github.com/orhun/git-cliff/pulls?q=is%3Apr++author%3AMuhammad-Owais-Warsi",
        description:
            "Highly customizable Changelog Generator following Conventional Commit specifications.",
    },
    {
        name: "kmon",
        url: "https://github.com/orhun/kmon/pull/174",
        description: "Linux Kernel Manager and Activity Monitor.",
    },
    {
        name: "Contribhub",
        url: "https://github.com/graphicmade/contribhub/pull/36",
        description: "Platform to find and contribute to open source projects.",
    },
];
---

<section id="open-source" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-10">
    <div class="mx-auto max-w-3xl">
        <h2
            class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground mb-4 sm:mb-6"
        >
            Open Source Contributions
        </h2>

        <div class="grid grid-cols-1 gap-5 sm:gap-6">
            {
                CONTRIBUTIONS.map((contribution) => (
                    <article class="p-0">
                        <a
                            href={contribution.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex items-center gap-2 text-sm sm:text-base font-semibold text-foreground hover:text-primary hover:underline"
                        >
                            <span>{contribution.name}</span>
                            <FiArrowUpRight className="h-4 w-4 text-muted-foreground group-hover:text-primary" />
                        </a>
                        <p class="mt-2 text-xs sm:text-sm text-foreground/70 leading-relaxed">
                            {contribution.description}
                        </p>
                    </article>
                ))
            }
        </div>
    </div>
</section>
