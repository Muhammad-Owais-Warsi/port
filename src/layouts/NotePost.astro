---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import FormattedDate from "../components/FormattedDate.astro";
import SiteLayout from "./SiteLayout.astro";

interface Props {
    title: string;
    description: string;
    pubDate: Date;
    heroImage?: ImageMetadata;
}

const { title, description, pubDate, heroImage } = Astro.props;
const ogImage = heroImage ? heroImage : "/og.png";
---

<SiteLayout
    title={`Notes | ${title}`}
    description={description}
    image={ogImage}
    ogType="article"
>
    <article class="px-3 sm:px-4 pb-10 sm:pb-16 pt-4 sm:pt-6">
        <div class="mx-auto w-full max-w-4xl">
            {heroImage && (
                <Image
                    width={1020}
                    height={510}
                    src={heroImage}
                    alt="note-image"
                    class="w-full rounded-xl sm:rounded-2xl object-cover"
                />
            )}
        </div>
        <div
            class="mx-auto w-full max-w-2xl px-2 sm:px-4 pt-6 sm:pt-8 text-foreground/80"
        >
            <div class="mb-4 sm:mb-6 text-center">
                <p class="text-xs text-muted-foreground">
                    <FormattedDate date={pubDate} />
                </p>
                <h1 class="mt-3 sm:mt-4 text-2xl sm:text-3xl font-semibold tracking-tight text-foreground">
                    {title}
                </h1>
                <hr class="mt-6 border-border" />
            </div>
            <div class="prose prose-neutral dark:prose-invert max-w-none">
                <slot />
            </div>
        </div>
    </article>
</SiteLayout>
