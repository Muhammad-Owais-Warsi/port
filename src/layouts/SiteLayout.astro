---
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import generalOgImage from "../assets/og.png";
import blogOgImage from "../assets/og-blog.png";

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
    ogType?: "website" | "article";
    isBlog?: boolean;
}

const { title, description, image, ogType = "website", isBlog = false } = Astro.props;

// Determine which fallback image to use
const fallbackImage = isBlog ? blogOgImage : generalOgImage;
const finalImage = image ?? fallbackImage;
---

<!doctype html>
<html lang="en">
    <head>
        <ClientRouter />
        <BaseHead
            title={title}
            description={description}
            image={finalImage}
            ogType={ogType}
        />
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
    </body>
</html>
