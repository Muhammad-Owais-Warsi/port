---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import SiteLayout from "./SiteLayout.astro";
import blogFallbackImage from "../assets/og-blog.png";

type Props = CollectionEntry<"blog">["data"];

const { title, pubDate, updatedDate, heroImage } = Astro.props;
const ogImage = heroImage ?? blogFallbackImage;
---

<SiteLayout
    title="Owais | Blogs"
    description="Blog site"
    image={ogImage}
    ogType="article"
    isBlog={true}
>
    <article class="px-4 pb-16 pt-8">
        <div class="mx-auto w-full max-w-4xl">
            {
                heroImage && (
                    <Image
                        width={1020}
                        height={510}
                        src={heroImage}
                        alt="blog-image"
                        class="w-full rounded-2xl object-cover shadow-sm"
                    />
                )
            }
        </div>
        <div
            class="mx-auto w-full max-w-2xl px-0 sm:px-4 pt-8 text-foreground/80"
        >
            <div class="mb-6 text-center">
                <p class="text-sm text-muted-foreground">
                    <FormattedDate date={pubDate} />
                </p>
                {
                    updatedDate && (
                        <p class="mt-1 text-xs italic text-muted-foreground/80">
                            Last updated on <FormattedDate date={updatedDate} />
                        </p>
                    )
                }
                <h1
                    class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight text-foreground"
                >
                    {title}
                </h1>
                <hr class="mt-6 border-border" />
            </div>
            <div
                class="prose prose-neutral max-w-none [&_img]:mx-auto [&_img]:my-4"
            >
                <slot />
            </div>
        </div>
    </article>
</SiteLayout>
