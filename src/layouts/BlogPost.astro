---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import SiteLayout from "./SiteLayout.astro";
import blogFallbackImage from "../assets/og-blog.png";

type Props = CollectionEntry<"blog">["data"];

const { title, pubDate, updatedDate, heroImage } = Astro.props;
const ogImage = heroImage ?? blogFallbackImage;
---

<SiteLayout
    title="Owais | Blogs"
    description="Blog site"
    image={ogImage}
    ogType="article"
    isBlog={true}
>
    <article class="px-3 sm:px-4 pb-10 sm:pb-16 pt-6 sm:pt-8">
        <div class="mx-auto w-full max-w-4xl">
            {
                heroImage && (
                    <Image
                        width={1020}
                        height={510}
                        src={heroImage}
                        alt="blog-image"
                        class="w-full rounded-xl sm:rounded-2xl object-cover"
                    />
                )
            }
        </div>
        <div
            class="mx-auto w-full max-w-2xl px-2 sm:px-4 pt-6 sm:pt-8 text-foreground/80"
        >
            <div class="mb-4 sm:mb-6 text-center">
                <p class="text-xs sm:text-sm text-muted-foreground">
                    <FormattedDate date={pubDate} />
                </p>
                {
                    updatedDate && (
                        <p class="mt-1 text-xs italic text-muted-foreground/80">
                            Last updated on <FormattedDate date={updatedDate} />
                        </p>
                    )
                }
                <h1
                    class="mt-3 sm:mt-4 text-2xl sm:text-4xl font-semibold tracking-tight text-foreground"
                >
                    {title}
                </h1>
                <hr class="mt-6 border-border" />
            </div>
            <div
                class="prose prose-neutral max-w-none [&_a]:text-primary [&_a]:underline-offset-4"
            >
                <slot />
            </div>
        </div>
    </article>
    <script>
        document.querySelectorAll(".prose pre").forEach((pre) => {
            if (pre.querySelector(".copy-btn")) return;
            const btn = document.createElement("button");
            btn.className =
                "copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-muted hover:bg-muted/80 text-muted-foreground transition-colors";
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
            btn.title = "Copy code";
            pre.appendChild(btn);
            btn.addEventListener("click", async (e) => {
                e.stopPropagation();
                const code = pre.querySelector("code");
                const text = code?.innerText || "";
                await navigator.clipboard.writeText(text);
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
                btn.classList.add("text-green-500");
                setTimeout(() => {
                    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
                    btn.classList.remove("text-green-500");
                }, 2000);
            });
        });
    </script>
</SiteLayout>
