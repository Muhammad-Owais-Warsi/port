---
import { getCollection } from "astro:content";
import PostList from "../../components/blog/PostList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
    (a, b) =>
        (b.data.updatedDate ?? b.data.pubDate).valueOf() -
        (a.data.updatedDate ?? a.data.pubDate).valueOf(),
);

const pageTitle = `Owais | Blogs`;
const pageDescription = "Blog site";
---

<SiteLayout title={pageTitle} description={pageDescription} isBlog={true}>
    <section class="mx-auto w-full max-w-3xl px-4 py-8">
        <h1
            class="mb-8 text-balance text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight"
        >
            {pageTitle}
        </h1>
        <PostList posts={posts} />
    </section>
</SiteLayout>
